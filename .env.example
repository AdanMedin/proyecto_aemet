# --- Aplicación ---
APP_NAME=AEMET Forecast API
DEBUG=false

# --- Base de datos ---
# Credenciales del contenedor de Postgres (las usa docker-compose).
POSTGRES_USER=*****
POSTGRES_PASSWORD=*****
POSTGRES_DB=*****

# Cadena de conexión que usa la API. La app usa asyncpg -> esquema "postgresql://".
# Dentro de Docker el host es "postgres", eso ya lo fija docker-compose.
DATABASE_DSN=postgresql://*****:*****@localhost:5432/*****

# --- pgAdmin (opcional) ---
PGADMIN_EMAIL=admin@aemet.local
PGADMIN_PASSWORD=*****

# --- API AEMET ---
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api

# --- Modelos ML ---
# Carpeta con un .joblib por estación.
RUTA_MODELOS=proyecto_aemet_api/ml/artifacts

# --- Streamlit ---
API_BASE_URL=http://localhost:****
