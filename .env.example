# --- Aplicación ---
APP_NAME=AEMET Forecast API
DEBUG=false

# --- Base de datos (Postgres en Docker local) ---
DATABASE_URL=postgresql+psycopg://aemet:aemet@localhost:5432/aemet
POSTGRES_USER=aemet
POSTGRES_PASSWORD=aemet
POSTGRES_DB=aemet

# --- pgAdmin (opcional) ---
PGADMIN_EMAIL=admin@aemet.local
PGADMIN_PASSWORD=admin

# --- API AEMET ---
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api

# --- Modelo ---
MODEL_ARTIFACT_PATH=proyecto_aemet_api/ml/artifacts/model.pkl

# --- Streamlit ---
API_BASE_URL=http://localhost:8000
