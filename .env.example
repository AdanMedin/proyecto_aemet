# --- Aplicación ---
APP_NAME=AEMET Forecast API
DEBUG=false

# --- Base de datos ---
# Credenciales del contenedor de Postgres (las usa docker-compose).
POSTGRES_USER=aemet
POSTGRES_PASSWORD=aemet
POSTGRES_DB=aemet

# Cadena de conexión que usa la API. La app usa asyncpg -> esquema "postgresql://".
# Local (API fuera de Docker): host localhost.
# Dentro de Docker el host es "postgres"; eso ya lo fija docker-compose por ti.
DATABASE_DSN=postgresql://aemet:aemet@localhost:5432/aemet

# --- pgAdmin (opcional) ---
PGADMIN_EMAIL=admin@aemet.local
PGADMIN_PASSWORD=admin

# --- API AEMET ---
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api

# --- Modelos ML ---
# Carpeta con un .joblib por estación.
RUTA_MODELOS=proyecto_aemet_api/ml/artifacts

# --- Streamlit ---
API_BASE_URL=http://localhost:8000
