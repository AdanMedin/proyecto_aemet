# ============================================================
#  Archivo de REFERENCIA (sin secretos reales).
#  Copiar a .env y rellenar valores. El .env NO se sube a git.
# ============================================================

# --- Aplicación ---
APP_NAME=AEMET Forecast API
DEBUG=false

# --- Base de datos ---
# Credenciales del contenedor de Postgres (las usa docker-compose).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Cadena que usa la API (asyncpg -> esquema postgresql://).
# En docker-compose el host "postgres" se inyecta automaticamente.
DATABASE_DSN=postgresql://postgres:*****@postgres:5432/postgres

# --- pgAdmin ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- API AEMET ---
AEMET_API_KEY=
AEMET_BASE_URL=

# --- Modelos ML ---
# Carpeta local de modelos
RUTA_MODELOS=

# --- AWS S3 (producción) ---
# UN SOLO bucket para todo: datos crudos (raiz) + modelos (MODELOS_RF/).
# Si está relleno, la API descarga de aquí los modelos que no tenga en disco
# y la ingesta sube los pickles a la raiz del bucket.
# Vacío = solo disco local (desarrollo).
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DATABASE_DSN=postgresql://postgres:*****@database-1.xxxxx.eu-north-1.rds.amazonaws.com:5432/postgres

# --- Streamlit ---
API_BASE_URL=
