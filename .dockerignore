# ============================================================
# BUILD: Excluir archivos que NO necesita la imagen Docker
# (se montan en volumen o son solo para desarrollo/AWS)
# ============================================================

# Control de versiones
.git
.gitignore
.gitattributes

# Configuración local (secretos)
.env
.env.*

# Python caché
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Datos (se montan por volumen en docker-compose.yml)
datos/

# Scripts específicos de AWS (Lambda)
proyecto_aemet_api/scripts/lambdas/
proyecto_aemet_api/scripts/descargar_modelos.py
proyecto_aemet_api/scripts/train_model.py
proyecto_aemet_api/scripts/run_ingestion.py

# Desarrollo (notebooks, tests, streamlit)
**/*.ipynb
**/*.ipynb_checkpoints
streamlit_app/
tests/

# Documentación (no necesaria en runtime)
*.md
docs/
README.md

# IDE
.vscode
.idea
*.swp
.DS_Store
